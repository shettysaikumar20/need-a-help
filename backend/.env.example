# Need A Help - Backend Configuration Example
# Copy to .env and configure your keys

# Primary Online AI - Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback Online AI - Backboard API Key
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_ASSISTANT_ID=

# Tertiary Fallback Online AI - OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local / Offline AI - Ollama Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:270m

# Server Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATA_DIR=
